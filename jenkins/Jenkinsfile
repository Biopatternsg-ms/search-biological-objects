pipeline {
    agent {
        docker {
            image 'mi-agente-jenkins-maven:1.0'
            args '-v /root/.m2:/root/.m2 -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        CONTAINER_NAME = "${env.JOB_NAME.toLowerCase().replaceAll('[^a-z0-9-]', '-')}"
    }

    stages {

        stage('Test') {
            steps {
                echo "--- Ejecutando Pruebas Unitarias ---"
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                echo "--- Compilando y Empaquetando la Aplicación ---"
                sh 'mvn package -DskipTests'
                echo "--- Guardando artefactos para la siguiente etapa (stash) ---"
                stash name: 'quarkus-app', includes: 'target/quarkus-app/**'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "--- Recuperando artefactos (unstash) ---"
                    unstash 'quarkus-app'

                    // Usaremos la etiqueta 'latest' para esta imagen.
                    def localImageName = "${CONTAINER_NAME}:latest"

                    echo "--- Construyendo Imagen Docker Local: ${localImageName} ---"
                    sh "docker build -t ${localImageName} ."
                    echo "--- ¡Imagen Docker construida exitosamente! ---"
                }
            }
        }

        // --- NUEVA ETAPA DE DESPLIEGUE ---
        stage('Deploy Application') {
            steps {
                script {
                    def imageName = "${CONTAINER_NAME}:latest"

                    echo "--- Desplegando el contenedor: ${CONTAINER_NAME} ---"

                    // Detenemos el contenedor si ya existe.
                    // '|| true' asegura que el pipeline no falle si el contenedor no existe la primera vez.
                    echo "1/3 - Deteniendo contenedor antiguo (si existe)..."
                    sh "docker stop ${CONTAINER_NAME} || true"

                    // Eliminamos el contenedor antiguo para limpiar.
                    echo "2/3 - Eliminando contenedor antiguo (si existe)..."
                    sh "docker rm ${CONTAINER_NAME} || true"

                    // Ejecutamos el nuevo contenedor con la imagen recién construida.
                    echo "3/3 - Iniciando nuevo contenedor..."
                    sh """
                    docker run -d \\
                        --name ${CONTAINER_NAME} \\
                        -p 8080:8080 \\
                        --restart always \\
                        ${imageName}
                    """

                    echo "--- ¡Despliegue completado! La aplicación debería estar disponible en el puerto 8080. ---"
                }
            }
        }
    }

    // Acciones Post-Ejecución.
    post {
        success {
            echo "--- Archivando artefactos de la compilación ---"
            archiveArtifacts artifacts: 'target/quarkus-app/**', fingerprint: true
        }
        always {
            echo "--- Limpiando el workspace ---"
            deleteDir()
        }
    }
}