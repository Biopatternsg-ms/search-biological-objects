pipeline {
    // 1. CAMBIO PRINCIPAL: Apuntamos al nuevo agente que construimos con GraalVM.
    agent {
        docker {
            // Reemplaza 'quarkus-native-builder-agent:latest' con el nombre y tag que le diste a tu imagen.
            image 'quarkus-native-builder-agent:latest'
            args '-v /root/.m2:/root/.m2 -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        CONTAINER_NAME = "${env.JOB_NAME.toLowerCase().replaceAll('[^a-z0-9-]', '-')}"
    }

    stages {

        // ETAPA A: Las pruebas se ejecutan en la JVM. ¡Esto no cambia y es la mejor práctica!
        stage('Test') {
            steps {
                echo "--- Running Unit Tests ---"
                sh 'mvn test'
            }
        }

        // ETAPA B: Esta es la etapa que más cambia.
        stage('Build Native Executable') { // Renombrada para mayor claridad
            steps {
                echo "--- Compiling Native Executable ---"
                // 2. CAMBIO CLAVE: Usamos el perfil 'native' de Maven.
                //    -Pnative: Activa la compilación nativa de Quarkus.
                //    -Dquarkus.native.container-build=false: ¡MUY IMPORTANTE! Le dice a Quarkus
                //    que no intente usar otro Docker para compilar, porque nuestro agente YA
                //    es el entorno de compilación nativa perfecto.
                sh 'mvn package -Pnative -DskipTests -Dquarkus.native.container-build=false'

                echo "--- Stashing native executable for the next stage ---"
                // 3. CAMBIO DE ARTEFACTO: El resultado ya no es 'target/quarkus-app',
                //    sino un único ejecutable en 'target/' que termina en '-runner'.
                stash name: 'quarkus-native-app', includes: 'target/*-runner'

                echo "--- Archiving build artifacts ---"
                archiveArtifacts artifacts: 'target/*-runner', fingerprint: true
            }
        }

        // ETAPA C: La lógica no cambia, solo el nombre del 'unstash'.
        stage('Build Docker Image') {
            steps {
                script {
                    echo "--- Unstashing artifacts ---"
                    // 4. Usamos el nuevo nombre del stash.
                    unstash 'quarkus-native-app'

                    def localImageName = "${CONTAINER_NAME}:latest"

                    echo "--- Building Local Docker Image: ${localImageName} ---"
                    // Este comando no cambia. Docker usará el nuevo Dockerfile nativo que creaste.
                    sh "docker build -t ${localImageName} ."
                    echo "--- Docker image built successfully! ---"
                }
            }
        }

        // ETAPA D: El despliegue es EXACTAMENTE IGUAL. La belleza de los contenedores.
        stage('Deploy Application') {
            steps {
                script {
                    def imageName = "${CONTAINER_NAME}:latest"

                    echo "--- Deploying container: ${CONTAINER_NAME} ---"
                    sh "docker stop ${CONTAINER_NAME} || true"
                    sh "docker rm ${CONTAINER_NAME} || true"

                    sh """
                    docker run -d \\
                        --name ${CONTAINER_NAME} \\
                        -p 8001:8080 \\
                        --restart always \\
                        ${imageName}
                    """
                    echo "--- Deployment completed! ---"
                }
            }
        }
    }

    post {
        always {
            echo "--- Cleaning up the workspace ---"
            deleteDir()
        }
    }
}