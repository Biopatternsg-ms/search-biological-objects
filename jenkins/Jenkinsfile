pipeline{
    agent any
    stages{
        environment {
                PIPELINE_NAME = "${env.JOB_NAME}"
        }
        stage('Test'){
              agent {
                  docker {
                      image 'jelastic/maven:3.9.5-openjdk-21'
                      args '-v /root/.m2:/root/.m2'
                  }
              }
              steps{
                   sh 'mvn test'
              }
        }
        stage('package'){
                   agent {
                        docker {
                            image 'jelastic/maven:3.9.5-openjdk-21'
                            args '-v /root/.m2:/root/.m2'
                        }
                   }
                   steps{
                    script {
                        sh 'mvn package -DskipTests'
                        sh 'cp -R target/ /var/jenkins_home/workspace/${PIPELINE_NAME}/target'
                    }
                   }
        }

    }
}