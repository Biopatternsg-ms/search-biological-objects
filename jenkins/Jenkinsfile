pipeline {
    // 1. AGENTE DE EJECUCIÓN
    // --- CAMBIO CLAVE ---
    // Cambiamos la imagen por una oficial de Maven que es más completa.
    // La imagen oficial 'maven' suele incluir herramientas comunes como git y, a veces, docker client.
    // Usaremos una etiqueta específica para Java 21.
    agent {
        docker {
            image 'mi-agente-jenkins-maven:1.0' // Imagen oficial de Maven con JDK 21
            args '-v /root/.m2:/root/.m2 -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    // 2. VARIABLES DE ENTORNO
    environment {
       PIPELINE_NAME = "${env.JOB_NAME}"
    }

    // 3. ETAPAS DEL PIPELINE
    stages {

        // Etapa A: Probar el código
        stage('Test') {
            steps {
                echo "--- Ejecutando Pruebas Unitarias ---"
                sh 'mvn test'
            }
        }

        // Etapa B: Empaquetar la aplicación
        stage('Package') {
            steps {
                echo "--- Compilando y Empaquetando la Aplicación ---"
                sh 'mvn package -DskipTests'

                //sh 'cp -R target/ /var/jenkins_home/workspace/${PIPELINE_NAME}/target'
            }
        }

        // Etapa C: Construir la imagen Docker
        stage('Build Local Docker Image') {
            steps {
                script {
                   sh 'docker build -t biopatternsg/search-biological-objects .'
                }
            }
        }
    }

    // 4. ACCIONES POST-EJECUCIÓN
    post {
        success {
            echo "--- Archivando artefactos de la compilación ---"
        }
        always {
            echo "--- Limpiando el workspace ---"
            deleteDir()
        }
    }
}